<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.ViewModels"
             x:Class="Station.Desktop.Controls.PaginationBar"
             x:DataType="vm:PaginationViewModel">

  <!-- 说明：本控件不含业务逻辑，样式全部来自 Themes/Controls.axaml 的 Button.page / ComboBox.field，
       跟随 Light/Dark 主题，热区走 Dimensions.axaml 的 ControlMinSize(44) -->

  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
        MinHeight="{DynamicResource ControlMinSize}">

    <TextBlock Grid.Column="0"
               Text="{Binding SummaryText}"
               FontSize="{DynamicResource FontSizeBase}"
               Foreground="{DynamicResource TextSecondary}"
               VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" />

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

      <ComboBox Classes="field" Width="100"
                ItemsSource="{Binding PageSizeOptions}"
                SelectedItem="{Binding PageSize}"
                IsVisible="{Binding ShowPageSizeSelector}" />

      <Button Classes="page" Content="首页" Command="{Binding FirstPageCommand}" />
      <Button Classes="page" Content="上一页" Command="{Binding PrevPageCommand}" />

      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowQuickJump}">
        <TextBlock Text="第"
                   FontSize="{DynamicResource FontSizeBase}"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" />
        <!-- NumericUpDown.Value 是 decimal?，清空输入会抛 Invalid cast from string to decimal?，
             TargetNullValue / FallbackValue 必须带 -->
        <NumericUpDown Classes="field" Width="70"
                       Value="{Binding PageInput, TargetNullValue=0, FallbackValue=0}"
                       Minimum="1" Maximum="{Binding MaxPage}"
                       Increment="1" FormatString="0" ShowButtonSpinner="False"
                       VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalPages, StringFormat='/ 共 {0} 页'}"
                   FontSize="{DynamicResource FontSizeBase}"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" />
        <Button Classes="page" Content="跳转" Command="{Binding GoToPageCommand}" />
      </StackPanel>

      <Button Classes="page" Content="下一页" Command="{Binding NextPageCommand}" />
      <Button Classes="page" Content="末页" Command="{Binding LastPageCommand}" />

      <Button Classes="page" Content="刷新" Command="{Binding RefreshCommand}"
              IsVisible="{Binding ShowRefresh}" />

    </StackPanel>

  </Grid>
</UserControl>
