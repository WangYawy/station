<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Station.Desktop.Views.MessageDialog"
        Width="380" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <TextBlock x:Name="IconText" FontSize="28" VerticalAlignment="Top"/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="280"
                 VerticalAlignment="Center"/>
    </StackPanel>
    <Button Grid.Row="1" Content="确定" Width="80"
            HorizontalAlignment="Right" Margin="0,20,0,0"
            Click="OnOkClick"/>
  </Grid>
</Window>
