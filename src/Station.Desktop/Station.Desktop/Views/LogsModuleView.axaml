<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.ViewModels"
             xmlns:audit="using:Station.Application.Audit"
             xmlns:conv="using:Station.Desktop.Converters"
             xmlns:controls="using:Station.Desktop.Controls"
             x:Class="Station.Desktop.Views.LogsModuleView"
             x:DataType="vm:LogsModuleViewModel">

  <UserControl.Resources>
    <conv:StringToBrushConverter x:Key="StringToBrush" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto"
        Margin="{DynamicResource PaddingCard}"
        RowSpacing="{DynamicResource SpacingGridGap}">

    <!-- 标题 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <TextBlock Text="日志中心"
                 FontSize="{DynamicResource FontSizeTitle}"
                 FontWeight="Bold"
                 Foreground="{DynamicResource BrandPrimaryDark}"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Column="1"
                 Text="{Binding Message}"
                 FontSize="{DynamicResource FontSizeBase}"
                 Foreground="{DynamicResource TextDanger}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                  IsVisible="{Binding Pager.IsLoading}">
        <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                     Foreground="{DynamicResource ProgressFill}"
                     VerticalAlignment="Center" />
        <TextBlock Text="加载中…"
                   FontSize="{DynamicResource FontSizeBase}"
                   Foreground="{DynamicResource TextTertiary}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- 搜索条件：两行 -->
    <Border Grid.Row="1" Classes="panel-card" Padding="12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
          <TextBlock Classes="field-label" Text="详情关键词" />
          <TextBox Classes="field"
                   Text="{Binding DetailKeyword}"
                   Watermark="仅搜索详情列，回车查询">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Classes="field-label" Text="操作人" />
          <ComboBox Classes="field" Width="200"
                    ItemsSource="{Binding Operators}"
                    SelectedItem="{Binding SelectedOperator}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OperatorOption">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{DynamicResource FontSizeMedium}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Classes="field-label" Text="操作类型" />
          <ComboBox Classes="field" Width="140"
                    ItemsSource="{Binding OperationTypes}"
                    SelectedItem="{Binding SelectedType}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OperationTypeOption">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{DynamicResource FontSizeMedium}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="3">
          <TextBlock Classes="field-label" Text="结果" />
          <ComboBox Classes="field" Width="100"
                    ItemsSource="{Binding ResultOptions}"
                    SelectedItem="{Binding SelectedResult}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultOption">
                <TextBlock Text="{Binding Text}"
                           FontSize="{DynamicResource FontSizeMedium}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Classes="field-label" Text="时间范围" />
          <ComboBox Classes="field" Width="120"
                    ItemsSource="{Binding TimeRangePresets}"
                    SelectedItem="{Binding SelectedTimeRange}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TimeRangePreset">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{DynamicResource FontSizeMedium}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="5" IsVisible="{Binding IsCustomRange}">
          <TextBlock Classes="field-label" Text="开始日期" />
          <CalendarDatePicker Classes="field" Width="160"
                              SelectedDate="{Binding CustomDateFrom, Mode=TwoWay}"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy-MM-dd"
                              PlaceholderText="选择开始"
                              FirstDayOfWeek="Monday"
                              IsTodayHighlighted="True" />
        </StackPanel>

        <StackPanel Grid.Column="6" IsVisible="{Binding IsCustomRange}">
          <TextBlock Classes="field-label" Text="结束日期" />
          <CalendarDatePicker Classes="field" Width="160"
                              SelectedDate="{Binding CustomDateTo, Mode=TwoWay}"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy-MM-dd"
                              PlaceholderText="选择结束"
                              FirstDayOfWeek="Monday"
                              IsTodayHighlighted="True" />
        </StackPanel>

        <Button Grid.Column="7" Classes="filter-ghost" Content="重置"
                Command="{Binding ResetCommand}"
                VerticalAlignment="Bottom" />
        <Button Grid.Column="8" Classes="filter-primary" Content="查询"
                Command="{Binding SearchCommand}"
                VerticalAlignment="Bottom" />
      </Grid>

    </Border>

    <!-- 列表 -->
    <Border Grid.Row="2" Classes="panel-card" Padding="6">
      <Panel>
        <DataGrid Classes="list-grid" ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="时间" Width="180" SortMemberPath="TimeText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <TextBlock Text="{Binding TimeText}"
                             Foreground="{DynamicResource TextSecondary}"
                             VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="操作人" Width="120" SortMemberPath="Operator">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <TextBlock Text="{Binding Operator}"
                             Foreground="{DynamicResource TextPrimary}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="操作类型" Width="130" SortMemberPath="Type">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <TextBlock Text="{Binding TypeText}"
                             Foreground="{DynamicResource TextPrimary}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="对象" Width="160" SortMemberPath="Target">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <TextBlock Text="{Binding Target}"
                             Foreground="{DynamicResource TextSecondary}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="详情" Width="*" SortMemberPath="Detail">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <TextBlock Text="{Binding Detail}"
                             Foreground="{DynamicResource TextSecondary}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="结果" Width="100" SortMemberPath="ResultText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="audit:AuditLogDto">
                  <Border CornerRadius="{DynamicResource RadiusBadge}"
                          Padding="{DynamicResource PaddingBadge}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          Background="{Binding ResultColor, Converter={StaticResource StringToBrush}, ConverterParameter=bg}">
                    <TextBlock Text="{Binding ResultText}"
                               FontSize="{DynamicResource FontSizeBase}"
                               FontWeight="SemiBold"
                               Foreground="{Binding ResultColor, Converter={StaticResource StringToBrush}}"
                               HorizontalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Classes="list-empty" Text="没有符合条件的日志"
                   IsVisible="{Binding IsEmpty}" />
      </Panel>
    </Border>

    <!-- 分页 -->
    <controls:PaginationBar Grid.Row="3" DataContext="{Binding Pager}" />

  </Grid>
</UserControl>
