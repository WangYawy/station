<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Station.Desktop.ViewModels"
        x:Class="Station.Desktop.Views.TaskFilesWindow"
        x:DataType="vm:TaskFilesViewModel"
        Title="{Binding Title}"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <TextBlock Grid.Row="0" Text="{Binding SummaryText}"
               FontWeight="SemiBold" Margin="0,0,0,8"/>
    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Files}"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
        <DataGridTextColumn Header="大小"   Binding="{Binding SizeText}" Width="100"/>
        <DataGridTemplateColumn Header="状态" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StatusText}"
                         Foreground="{Binding StatusBrush}"
                         FontWeight="SemiBold"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
