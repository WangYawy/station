<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.ViewModels"
             xmlns:app="using:Station.Application.Settings"
             x:Class="Station.Desktop.Views.SettingsModuleView"
             x:DataType="vm:SettingsModuleViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">

    <!-- 标题栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <TextBlock Text="系统设置" FontSize="18" FontWeight="Bold" Foreground="#0a2f6c"
                 VerticalAlignment="Center" />
      <Border Background="#fef3c7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
              IsVisible="{Binding IsReadOnly}">
        <TextBlock Text="平台版配置由平台统一下发，本地只读" FontSize="12" Foreground="#b45309" />
      </Border>
    </StackPanel>

    <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent">

      <!-- ==================== 基本设置 ==================== -->
      <TabItem Header="📋 基本设置">
        <StackPanel Spacing="10" Margin="8,4">
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="本机编号" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Basic.StationNo}" IsReadOnly="True" Width="220" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="安装位置" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Basic.InstallLocation}" IsEnabled="{Binding CanEdit}"
                     Width="320" HorizontalAlignment="Left" Watermark="如：一楼大厅东侧" />
          </Grid>
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="运行模式" VerticalAlignment="Center" Foreground="#334155" />
            <ComboBox Grid.Column="1" SelectedIndex="{Binding RunModeIndex}" IsEnabled="{Binding CanEdit}"
                      Width="160" HorizontalAlignment="Left">
              <ComboBoxItem Content="单机版" />
              <ComboBoxItem Content="平台版" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="平台地址" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Basic.PlatformBaseUrl}" IsEnabled="{Binding CanEdit}"
                     Width="320" HorizontalAlignment="Left" Watermark="http://平台IP:端口（平台版）" />
          </Grid>
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="平台站点编号" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Basic.PlatformStationCode}" IsEnabled="{Binding CanEdit}"
                     Width="200" HorizontalAlignment="Left" />
          </Grid>
          <Button Content="保存基本设置" Command="{Binding SaveBasicCommand}" IsEnabled="{Binding CanEdit}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>

      <!-- ==================== 存储策略（多目标） ==================== -->
      <TabItem Header="💾 存储策略">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="8,4">

            <!-- 全局参数 -->
            <Border Background="#f1f5f9" CornerRadius="6" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock Text="全局参数" FontWeight="SemiBold" Foreground="#0a2f6c" />

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="上传目录模板" VerticalAlignment="Center" Foreground="#334155" />
                  <TextBox Grid.Column="1" Text="{Binding Storage.DirectoryTemplate}" IsEnabled="{Binding CanEdit}"
                           Width="420" HorizontalAlignment="Left" />
                </Grid>

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="远端内容模式" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedIndex="{Binding RemoteContentModeIndex}"
                            IsEnabled="{Binding CanEdit}" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="明文（推荐，平台直接可读）" />
                    <ComboBoxItem Content="密文（端到端加密）" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="⚠ 密文模式下远端无法重算摘要，仅做大小校验；平台需要对应密钥才能解密。"
                           Foreground="#b45309" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding ShowCiphertextWarning}" />

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="远端校验模式" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedIndex="{Binding RemoteVerifyModeIndex}"
                            IsEnabled="{Binding CanEdit}" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="仅大小（最快）" />
                    <ComboBoxItem Content="抽样校验" />
                    <ComboBoxItem Content="完整摘要（最慢）" />
                  </ComboBox>
                </Grid>

                <CheckBox Content="上传时对文件元数据签名（SM2-SM3）"
                          IsChecked="{Binding Storage.EnableFileSignature}"
                          IsEnabled="{Binding CanEdit}" />

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="熔断阈值" VerticalAlignment="Center" Foreground="#334155" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding Storage.CircuitBreakerThreshold}" IsEnabled="{Binding CanEdit}" Width="80" />
                    <TextBlock Text="次 / 冷却" VerticalAlignment="Center" Foreground="#64748b" />
                    <TextBox Text="{Binding Storage.CircuitBreakerCooldownSeconds}" IsEnabled="{Binding CanEdit}" Width="80" />
                    <TextBlock Text="秒" VerticalAlignment="Center" Foreground="#64748b" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="保留天数" VerticalAlignment="Center" Foreground="#334155" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding Storage.VideoRetentionDays}" IsEnabled="{Binding CanEdit}" Width="70" />
                    <TextBlock Text="天（视频）" VerticalAlignment="Center" Foreground="#64748b" />
                    <TextBox Text="{Binding Storage.LogRetentionDays}" IsEnabled="{Binding CanEdit}" Width="70" />
                    <TextBlock Text="天（日志）" VerticalAlignment="Center" Foreground="#64748b" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                  <TextBlock Text="清理执行时间" VerticalAlignment="Center" Foreground="#334155" />
                  <TextBox Grid.Column="1" Text="{Binding Storage.CleanupTime}" IsEnabled="{Binding CanEdit}"
                           Width="100" HorizontalAlignment="Left" Watermark="HH:mm" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 多目标列表 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="存储目标列表" FontWeight="SemiBold" Foreground="#0a2f6c"
                         VerticalAlignment="Center" />
              <Button Content="+ 添加目标" Command="{Binding AddStorageTargetCommand}"
                      IsEnabled="{Binding CanEdit}" />
              <TextBlock Text="（可同时上传到多个位置）" Foreground="#94a3b8" FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding StorageTargets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageTargetForm">
                  <Border Background="#f8fafc" CornerRadius="6" Padding="12" Margin="0,4">
                    <StackPanel Spacing="8">

                      <!-- 头部：类型 / 名称 / 启用 / 主 / 删除 -->
                      <Grid ColumnDefinitions="120,180,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <ComboBox SelectedItem="{Binding Kind}" Width="110"
                                  IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}">
                          <ComboBoxItem Content="Local" />
                          <ComboBoxItem Content="Ftp" />
                          <ComboBoxItem Content="Sftp" />
                        </ComboBox>

                        <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="目标名称"
                                 IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />

                        <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Enabled}"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />

                        <CheckBox Grid.Column="3" Content="主" IsChecked="{Binding IsPrimary}"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                          <Button Content="复制" FontSize="12"
                                  Command="{Binding $parent[UserControl].DataContext.DuplicateStorageTargetCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                          <Button Content="删除" FontSize="12"
                                  Command="{Binding $parent[UserControl].DataContext.RemoveStorageTargetCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                        </StackPanel>
                      </Grid>

                      <!-- Local -->
                      <Grid ColumnDefinitions="120,*" ColumnSpacing="8" IsVisible="{Binding IsLocal}">
                        <TextBlock Text="本地根目录" VerticalAlignment="Center" Foreground="#334155" />
                        <TextBox Grid.Column="1" Text="{Binding LocalRoot}"
                                 IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                      </Grid>

                      <!-- FTP -->
                      <StackPanel Spacing="6" IsVisible="{Binding IsFtp}">
                        <Grid ColumnDefinitions="120,*,Auto,100" ColumnSpacing="8">
                          <TextBlock Text="FTP 主机" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding FtpHost}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                          <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" />
                          <TextBox Grid.Column="3" Text="{Binding FtpPort}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                          <TextBlock Text="FTP 账号" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding FtpUser}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                          <TextBlock Text="FTP 密码（明文）" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding FtpPassword}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}"
                                   Watermark="留空则不修改" />
                        </Grid>
                      </StackPanel>

                      <!-- SFTP -->
                      <StackPanel Spacing="6" IsVisible="{Binding IsSftp}">
                        <Grid ColumnDefinitions="120,*,Auto,100" ColumnSpacing="8">
                          <TextBlock Text="SFTP 主机" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding SftpHost}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                          <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" />
                          <TextBox Grid.Column="3" Text="{Binding SftpPort}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                          <TextBlock Text="SFTP 账号" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding SftpUser}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                          <TextBlock Text="SFTP 密码（明文）" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding SftpPassword}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}"
                                   Watermark="留空则不修改" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                          <TextBlock Text="SFTP 根目录" VerticalAlignment="Center" Foreground="#334155" />
                          <TextBox Grid.Column="1" Text="{Binding SftpRoot}"
                                   IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}"
                                   Watermark="留空使用用户主目录" />
                        </Grid>
                      </StackPanel>

                      <!-- 覆盖项 -->
                      <Grid ColumnDefinitions="120,Auto,80,Auto,80" ColumnSpacing="8">
                        <TextBlock Text="重试次数" VerticalAlignment="Center" Foreground="#334155" />
                        <TextBox Grid.Column="1" Text="{Binding RetryCount}" Width="60"
                                 IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}"
                                 Watermark="默认" />
                        <TextBlock Grid.Column="2" Text="熔断阈值" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox Grid.Column="3" Text="{Binding CircuitBreakerThreshold}" Width="60"
                                 IsEnabled="{Binding $parent[UserControl].DataContext.CanEdit}"
                                 Watermark="默认" />
                      </Grid>

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 保存按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <Button Content="保存存储策略" Command="{Binding SaveStorageCommand}" IsEnabled="{Binding CanEdit}" />
              <TextBlock Text="存储目标/连接参数修改需重启后生效" Foreground="#94a3b8" FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== 采集策略 ==================== -->
      <TabItem Header="📡 采集策略">
        <StackPanel Spacing="14" Margin="8,4">
          <CheckBox Content="记录仪接入后自动开始采集" IsChecked="{Binding Collect.AutoCollectOnConnect}" IsEnabled="{Binding CanEdit}" />
          <CheckBox Content="任务完成后擦除记录仪上已采集文件" IsChecked="{Binding Collect.EraseAfterComplete}" IsEnabled="{Binding CanEdit}" />
          <CheckBox Content="已采集过的文件自动跳过" IsChecked="{Binding Collect.SkipCollected}" IsEnabled="{Binding CanEdit}" />
          <CheckBox Content="采集附属文件（日志、图片、音频）" IsChecked="{Binding Collect.CollectAncillaryFiles}" IsEnabled="{Binding CanEdit}" />
          <Button Content="保存采集策略" Command="{Binding SaveCollectCommand}" IsEnabled="{Binding CanEdit}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>

      <!-- ==================== 工作台显示 ==================== -->
      <TabItem Header="🖥️ 工作台显示">
        <StackPanel Spacing="10" Margin="8,4">
          <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
            <TextBlock Text="卡片行数" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Workbench.Rows}" IsEnabled="{Binding CanEdit}"
                     Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
            <TextBlock Text="每行卡片数" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Workbench.Columns}" IsEnabled="{Binding CanEdit}"
                     Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
            <TextBlock Text="卡片宽度（px）" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Workbench.CardWidth}" IsEnabled="{Binding CanEdit}"
                     Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
            <TextBlock Text="卡片高度（px）" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Workbench.CardHeight}" IsEnabled="{Binding CanEdit}"
                     Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
            <TextBlock Text="紧急优先上限" VerticalAlignment="Center" Foreground="#334155" />
            <TextBox Grid.Column="1" Text="{Binding Workbench.MaxEmergencyTasks}" IsEnabled="{Binding CanEdit}"
                     Width="90" HorizontalAlignment="Left" />
          </Grid>
          <TextBlock Text="总通道数 = 行数 × 每行卡片数；卡片宽高按配置动态排布。紧急优先由操作员在卡片上标记，达到上限后需先取消其他优先任务。"
                     Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap" MaxWidth="420" />
          <Button Content="保存工作台显示设置" Command="{Binding SaveWorkbenchCommand}" IsEnabled="{Binding CanEdit}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>

      <!-- ==================== 网络安全 ==================== -->
      <TabItem Header="🔐 网络安全">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="8,4">
            <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Web 端口" VerticalAlignment="Center" Foreground="#334155" />
              <TextBox Grid.Column="1" Text="{Binding Network.WebPort}" IsEnabled="{Binding CanEdit}" Width="100" HorizontalAlignment="Left" />
              <TextBlock Grid.Column="2" Text="重启后生效" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#94a3b8" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
              <TextBlock Text="HTTPS 端口" VerticalAlignment="Center" Foreground="#334155" />
              <TextBox Grid.Column="1" Text="{Binding Network.HttpsPort}" IsEnabled="{Binding CanEdit}" Width="100" HorizontalAlignment="Left" />
            </Grid>
            <CheckBox Content="开启局域网访问（监听 0.0.0.0，强制 HTTPS）" IsChecked="{Binding Network.EnableLan}" IsEnabled="{Binding CanEdit}" />
            <CheckBox Content="允许 HTTP（关闭后局域网仅 HTTPS）" IsChecked="{Binding Network.AllowHttp}" IsEnabled="{Binding CanEdit}" />
            <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
              <TextBlock Text="HTTPS 证书" VerticalAlignment="Center" Foreground="#334155" />
              <TextBlock Grid.Column="1" Text="{Binding Network.CertificateStatus}" VerticalAlignment="Center"
                         Foreground="#15803d" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
              <TextBlock Text="登录锁定" VerticalAlignment="Center" Foreground="#334155" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Network.MaxFailedAttempts}" IsEnabled="{Binding CanEdit}" Width="70" />
                <TextBlock Text="次 /" VerticalAlignment="Center" Foreground="#64748b" />
                <TextBox Text="{Binding Network.LockoutMinutes}" IsEnabled="{Binding CanEdit}" Width="70" />
                <TextBlock Text="分钟锁定" VerticalAlignment="Center" Foreground="#64748b" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <Button Content="保存网络安全设置" Command="{Binding SaveNetworkCommand}" IsEnabled="{Binding CanEdit}" />
              <TextBlock Text="证书上传请使用单机版 Web 后台（系统设置 → 网络安全）" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== 安全与加密 ==================== -->
      <TabItem Header="🔒 安全与加密">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="8,4" MaxWidth="760">

            <!-- 登录密码 -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="登录密码算法" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="算法" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.PasswordAlgorithm}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="PBKDF2-HMAC-SM3" />
                    <ComboBoxItem Content="MD5" />
                    <ComboBoxItem Content="PBKDF2-SHA256" />
                  </ComboBox>
                </Grid>
                <CheckBox Content="允许旧算法回退（迁移期）"
                          IsChecked="{Binding Crypto.PasswordAllowLegacy}"
                          IsEnabled="{Binding CanEdit}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="迁移存量密码"
                          Command="{Binding MigratePasswordsCommand}"
                          IsEnabled="{Binding CanEdit}"
                          IsVisible="{Binding !IsMigrating}" />
                  <ProgressBar IsIndeterminate="True" Width="120"
                               IsVisible="{Binding IsMigrating}" />
                </StackPanel>
                <TextBlock Text="切换算法不会自动迁移历史数据；勾选“允许旧算法回退”后，用户首次成功登录时会自动重哈希。"
                           Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 授权文件 -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="授权文件算法" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="内容加密" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.LicenseEncrypt}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM4-GCM" />
                    <ComboBoxItem Content="AES-256-GCM" />
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="签名" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.LicenseSign}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM2-SM3" />
                    <ComboBoxItem Content="RSA-SHA256" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 文件签名（摘要 + 签名） -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="文件签名算法（元数据签名）" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="摘要" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.FileSigDigest}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM3" />
                    <ComboBoxItem Content="SHA-256" />
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="签名" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.FileSigSign}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM2-SM3" />
                    <ComboBoxItem Content="RSA-SHA256" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="变更后仅影响新采集文件的摘要；已采集数据保留原算法标记。"
                           Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- ★ 新增：文件内容加密 -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="文件内容加密（本地缓存 + 端到端）" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="算法" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.FileEncryptionAlgorithm}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM4-GCM" />
                    <ComboBoxItem Content="AES-256-GCM" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="采用 STFE 分块格式（默认 4MB/块），密钥由主密钥 HKDF 派生。切换后仅影响新加密文件，旧文件保留原算法标记。"
                           Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 敏感字段加密 -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="敏感字段加密（FTP/SFTP 密码等）" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                  <TextBlock Text="算法" VerticalAlignment="Center" Foreground="#334155" />
                  <ComboBox Grid.Column="1" SelectedItem="{Binding Crypto.SecretFieldAlgorithm}"
                            IsEnabled="{Binding CanEdit}" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="SM4-GCM" />
                    <ComboBoxItem Content="AES-256-GCM" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 主密钥 -->
            <Border Background="#f8fafc" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="主密钥" FontWeight="SemiBold" Foreground="#0a2f6c" />
                <TextBlock Text="{Binding MasterKeyStatus}" Foreground="#334155" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="轮换主密钥"
                          Command="{Binding RotateMasterKeyCommand}"
                          IsEnabled="{Binding CanEdit}"
                          IsVisible="{Binding !IsRotating}" />
                  <ProgressBar IsIndeterminate="True" Width="120"
                               IsVisible="{Binding IsRotating}" />
                </StackPanel>
                <TextBlock Text="轮换会生成新版本密钥，并异步重加密所有敏感字段；旧版本密钥保留以支持历史解密。"
                           Foreground="#94a3b8" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 保存 -->
            <Button Content="保存加密策略"
                    Command="{Binding SaveCryptoCommand}"
                    IsEnabled="{Binding CanEdit}"
                    HorizontalAlignment="Left" />

            <!-- 审计列表 -->
            <TextBlock Text="最近安全变更审计" FontWeight="SemiBold" Foreground="#0a2f6c" />
            <ListBox ItemsSource="{Binding CryptoAudits}" MinHeight="180" Background="White">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="150,120,180,*,60" ColumnSpacing="8" Margin="4,4">
                    <TextBlock Text="{Binding Time}" Foreground="#334155" />
                    <TextBlock Grid.Column="1" Text="{Binding Operator}" Foreground="#334155" />
                    <TextBlock Grid.Column="2" Text="{Binding Target}" Foreground="#0f766e" />
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="#64748b" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="4" Text="{Binding Result}" Foreground="#b45309" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== 授权与激活 ==================== -->
      <TabItem Header="🔑 授权与激活">
        <StackPanel Spacing="12" Margin="8,4" MaxWidth="520">
          <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
            <TextBlock Text="授权状态" VerticalAlignment="Center" Foreground="#334155" />
            <TextBlock Grid.Column="1" Text="{Binding LicenseStatus}" FontWeight="SemiBold"
                       Foreground="#15803d" TextWrapping="Wrap" />
          </Grid>
          <TextBox Text="{Binding LicenseText}" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="140" Watermark="粘贴授权文件内容（station.lic JSON）" IsEnabled="{Binding CanEdit}" />
          <Button Content="激活授权" Command="{Binding ActivateLicenseCommand}" IsEnabled="{Binding CanEdit}"
                  IsVisible="{Binding !IsReadOnly}" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <!-- ==================== 设备自检 ==================== -->
      <TabItem Header="🛠️ 设备自检">
        <StackPanel Spacing="12" Margin="8,4">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="一键自检" Command="{Binding RunSelfCheckCommand}" />
            <TextBlock Text="检测 USB 端口、磁盘、网络、存储目标" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding SelfCheckTime}" Foreground="#94a3b8" FontSize="12" />
          <ListBox ItemsSource="{Binding SelfCheckItems}" MinHeight="160" Background="White">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:SelfCheckItemDto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1e293b" />
                  <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="#64748b" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </TabItem>

    </TabControl>

    <!-- 底部状态栏 -->
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#0f766e" FontSize="13"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
