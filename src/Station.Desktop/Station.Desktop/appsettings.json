{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/desktop-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  // 数据相关配置
  "Data": {
    // 数据库连接配置
    "Db": {
      "Provider": "Sqlite", // 数据库类型
      "ConnectionString": "Data Source=station.db", // 连接字符串
      "IsAutoToUpper": false // 是否自动转大写，默认不转
    },
    // 雪花算法配置
    "SnowFlake": {
      "DatacenterId": 1, // 数据中心Id
      "WorkId": 1 // 节点Id
    },
    // 数据库备份配置
    "Backup": {
      "Enabled": true, // 是否开启备份
      "BackupDirectory": null, // 备份目录
      "RetentionCount": 7, // 留存计数
      "Hour": 3, // 执行备份小时数
      "Minute": 0
    },
    // 分页默认配置
    "Paging": {
      "DefaultPageSize": 20,
      "MaxPageSize": 200
    }
  },
  "Station": {
    // 身份识别认证
    "Auth": {
      "MaxFailedAttempts": 5, // 最大失败次数
      "LockoutMinutes": 15, // 锁定时长
      "AutoLogoutMinutes": 1 // 登录自动注销分钟数
    },
    "OpAuth": {
      "RequiredModules": [ "collect", "history", "logs", "alerts", "settings" ]
    },
    // 采集策略配置
    "Collect": {
      "AutoCollectOnConnect": true, // 设备连接自动采集
      "SkipCollected": true, // 是否跳过已采集
      "EraseAfterComplete": false, // 采集完整是否自动擦除
      "ChunkBytes": 1048576, // 读取流缓存字节大小 1M
      "SimulatedFileCount": 5
    },
    // 存储策略配置
    "Storage": {
      // 业务配置
      "DirectoryTemplate": "{StationNo}/{Date:yyyy-MM-dd}/{RecorderName}/{UserId}/{DeptId}/{FileType}",
      "StationNo": "ST0001",
      "ChunkBytes": 1048576, // 1M
      // 上传策略
      "RetryCount": 3, // 上传失败重试次数
      "RetryIntervalSeconds": 2, // 重试间隔（秒）
      "MaxRetryDelaySeconds": 30, // 最大重试延迟时间（秒），超过就直接中断
      "RetryJitterFactor": 0.3, // 重试抖动
      "MaxConcurrentUploads": 1, // 最大并发上传数
      // 校验策略
      "RemoteVerifyMode": "None", //远端校验模式，None - 只校验大小，SizeAndSample - 大小 + 抽样校验，Full - 完整 SM3（下载重算，最慢但最强）
      "RemoteContentMode": "Plaintext", // Plaintext - 上传明文，Ciphertext - 上传密文
      "EnableFileSignature": true, // 是否对文件元数据签名
      "MultiTargetMode": "AnySuccess", // 多 target 结果策略，AnySuccess - 任一 target 成功即认为成功，AllRequired - 全部 target 成功才成功，BestEffort - 主 target（IsPrimary=true）成功即可
      // 熔断全局默认
      "CircuitBreakerThreshold": 5, // 熔断器阈值
      "CircuitBreakerCooldownSeconds": 60, // 熔断器冷却秒数
      // 连接池
      "FtpKeepAliveSeconds": 30, // FTP 保活间隔（秒）
      "SftpPoolSize": 4, // SFTP 连接数
      "SftpKeepAliveSeconds": 30, // SFTP 保活间隔（秒）
      // 取消清理
      "CleanupOnCancel": true, // 取消时是否清理未上传成功文件
      "CleanupOnFailure": false, // 失败时是否清理
      // 存储目标
      "Targets": [
        {
          "Kind": "Local",
          "Name": "local-primary",
          "Enabled": true,
          "IsPrimary": true,
          "LocalRoot": "D:/StationStorage"
        },
        {
          "Kind": "Sftp",
          "Name": "sftp-backup",
          "Enabled": false,
          "SftpHost": "10.0.0.20",
          "SftpPort": 22,
          "SftpUser": "station",
          "SftpPassword": "",
          "SftpRoot": "/StationStorage"
        },
        {
          "Kind": "Ftp",
          "Name": "ftp-backup",
          "Enabled": true,
          "FtpHost": "192.168.1.33",
          "FtpPort": 21,
          "FtpUser": "admin",
          "FtpPassword": "123456"
        }
      ]
    },
    "Platform": {
      "Enabled": false,
      "BaseUrl": "http://localhost:5100",
      "StationCode": "ST0001",
      "SyncIntervalSeconds": 10,
      "CommandPollIntervalSeconds": 10,
      "TimeoutSeconds": 30
    },
    "Crypto": {
      "MasterKeyFile": "",
      "EnvOverrideVar": "STATION_MASTER_KEY",
      "FallbackDefaults": {
        "password": "PBKDF2-HMAC-SM3",
        "license": "SM4-GCM",
        "file_sig": "SM3",
        "secret_field": "SM4-GCM"
      }
    },
    "License": {
      "SignAlgorithm": "SM2-SM3",
      "EncryptAlgorithm": "SM4-GCM",
      "PublicKeyFile": "keys/license-public.pem",
      "PrivateKeyFile": "",
      "TrialDays": 30,
      "ProductCode": "STATION-DESKTOP-1"
    },
    "Command": {
      "PublicKeyFile": "keys/command-public.pem",
      "Required": false
    },
    "Reporting": {
      "SignAlgorithm": "SM2-SM3",
      "PrivateKeyFile": "keys/reporting-private.pem",
      "PublicKeyFile": "keys/reporting-public.pem"
    },
    "Binding": {
      "EnableBinding": true, // 总开关，是否启用绑定文件验证
      "EnableSignature": true, // 是否验证绑定文件 MAC
      "EnableBindingValidation": true // 是否验证用户和部门
    },
    "Web": {
      "ListenAddress": "127.0.0.1",
      "Port": 5005,
      "EnableLan": false, // 开启局域网访问（监听 0.0.0.0；开启后强制 HTTPS 与访问日志
      "EnableHttps": false,
      "HttpsPort": 5443,
      "AllowHttp": false // 局域网 HTTPS 模式下是否仍允许 HTTP 访问（推荐关闭）
    }
  }
}
