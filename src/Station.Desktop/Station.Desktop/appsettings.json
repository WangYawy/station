{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/desktop-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Data": {
    "Db": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=station.db",
      "IsAutoToUpper": false
    },
    "SnowFlake": {
      "DatacenterId": 1,
      "WorkId": 1
    },
    "Backup": {
      "Enabled": true,
      "BackupDirectory": null,
      "RetentionCount": 7,
      "Hour": 3,
      "Minute": 0
    }
  },
  "Station": {
    "Auth": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "AutoLogoutMinutes": 1
    },
    "OpAuth": {
      "RequiredModules": [ "collect", "history", "logs", "alerts", "settings" ]
    },
    "Collect": {
      "AutoCollectOnConnect": true,
      "SkipCollected": true,
      "EraseAfterComplete": true,
      "ChunkBytes": 1048576,
      "SimulatedFileCount": 5
    },
    "Storage": {
      "DirectoryTemplate": "{StationNo}/{Date:yyyy-MM-dd}/{RecorderName}/{UserId}/{DeptId}/{FileType}",
      "StationNo": "ST0001",
      "ChunkBytes": 1048576,
      "RemoteContentMode": "Plaintext",
      "EnableFileSignature": true,
      "RetryCount": 3,
      "RetryIntervalSeconds": 2,
      "MaxRetryDelaySeconds": 30,
      "RetryJitterFactor": 0.3,
      "MaxConcurrentUploads": 4,

      "RemoteVerifyMode": "None",

      "MultiTargetMode": "AnySuccess",

      "CircuitBreakerThreshold": 5,
      "CircuitBreakerCooldownSeconds": 60,

      "FtpKeepAliveSeconds": 30,
      "SftpPoolSize": 4,
      "SftpKeepAliveSeconds": 30,

      "CleanupOnCancel": true,
      "CleanupOnFailure": false,

      "Targets": [
        {
          "Kind": "Local",
          "Name": "local-primary",
          "Enabled": true,
          "IsPrimary": true,
          "LocalRoot": "D:/StationStorage"
        },
        {
          "Kind": "Sftp",
          "Name": "sftp-backup",
          "Enabled": false,
          "SftpHost": "10.0.0.20",
          "SftpPort": 22,
          "SftpUser": "station",
          "SftpPassword": "",
          "SftpRoot": "/data/station"
        }
      ]
    },
    "Platform": {
      "Enabled": false,
      "BaseUrl": "http://localhost:5100",
      "StationCode": "ST0001",
      "SyncIntervalSeconds": 10,
      "CommandPollIntervalSeconds": 10,
      "TimeoutSeconds": 30
    },
    "Crypto": {
      "MasterKeyFile": "",
      "EnvOverrideVar": "STATION_MASTER_KEY",
      "FallbackDefaults": {
        "password": "PBKDF2-HMAC-SM3",
        "license": "SM4-GCM",
        "file_sig": "SM3",
        "secret_field": "SM4-GCM"
      }
    },
    "License": {
      "SignAlgorithm": "SM2-SM3",
      "EncryptAlgorithm": "SM4-GCM",
      "PublicKeyFile": "keys/license-public.pem",
      "PrivateKeyFile": "",
      "TrialDays": 30,
      "ProductCode": "STATION-DESKTOP-1"
    },
    "Command": {
      "PublicKeyFile": "keys/command-public.pem",
      "Required": false
    },
    "Reporting": {
      "SignAlgorithm": "SM2-SM3",
      "PrivateKeyFile": "keys/reporting-private.pem",
      "PublicKeyFile": "keys/reporting-public.pem"
    },
    "Binding": {
      "EnableProfile": true,
      "EnableBinding": true,
      "EnableSecret": false,
      "SecretFile": "keys/binding-secret.key"
    },
    "Web": {
      "ListenAddress": "127.0.0.1",
      "Port": 5005,
      "EnableLan": false, // 开启局域网访问（监听 0.0.0.0；开启后强制 HTTPS 与访问日志
      "EnableHttps": false,
      "HttpsPort": 5443,
      "AllowHttp": false // 局域网 HTTPS 模式下是否仍允许 HTTP 访问（推荐关闭）
    }
  }
}
