<Project>
  <!--
    共享层（Station.Shared）版本号：两端共同消费的契约层。
    仅当契约出现不兼容变更时递增；两端产品各自版本见各自目录的 Directory.Build.props。
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
