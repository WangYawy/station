<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       布局高度
       ============================================================ -->
  <x:Double x:Key="ShellTopNavHeight">64</x:Double>
  <x:Double x:Key="ShellNoticeBarHeight">40</x:Double>
  <x:Double x:Key="ShellBottomBarHeight">56</x:Double>
  <x:Double x:Key="ShellCardMinHeight">80</x:Double>
  <x:Double x:Key="ShellIconBtnSize">48</x:Double>

  <!-- ============================================================
       控件热区（触屏优先）
       ============================================================ -->
  <x:Double x:Key="ControlMinSize">44</x:Double>
  <x:Double x:Key="NavPillHeight">46</x:Double>
  <x:Double x:Key="CardBtnMinHeight">40</x:Double>
  <x:Double x:Key="CardBtnMinWidth">56</x:Double>
  <x:Double x:Key="TouchTargetMinHeight">44</x:Double>

  <!-- ============================================================
       圆角
       ============================================================ -->
  <CornerRadius x:Key="RadiusPill">30</CornerRadius>
  <CornerRadius x:Key="RadiusCard">16</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">10</CornerRadius>
  <CornerRadius x:Key="RadiusCardBtn">15</CornerRadius>
  <CornerRadius x:Key="RadiusProgress">6</CornerRadius>
  <CornerRadius x:Key="RadiusDot">4</CornerRadius>
  <CornerRadius x:Key="RadiusCircle">9999</CornerRadius>

  <!-- ============================================================
       内边距
       ============================================================ -->
  <Thickness x:Key="PaddingTopNav">20,0</Thickness>
  <Thickness x:Key="PaddingNoticeBar">20,0</Thickness>
  <Thickness x:Key="PaddingBottomBar">20,0</Thickness>
  <Thickness x:Key="PaddingCard">14</Thickness>
  <Thickness x:Key="PaddingNavPill">20,10</Thickness>
  <Thickness x:Key="PaddingCardBtn">14,6</Thickness>
  <Thickness x:Key="PaddingBadge">10,2</Thickness>
  <Thickness x:Key="PaddingProtocolTag">8,1</Thickness>
  <Thickness x:Key="PaddingControlDefault">14,8</Thickness>

  <!-- ============================================================
       间距
       ============================================================ -->
  <x:Double x:Key="SpacingGridGap">16</x:Double>

  <!-- ============================================================
       滚动条
       ============================================================ -->
  <x:Double x:Key="TouchScrollBarWidth">14</x:Double>
  <x:Double x:Key="ScrollBarThumbMinWidth">12</x:Double>
  <x:Double x:Key="ScrollBarThumbMinHeight">24</x:Double>

  <!-- ============================================================
       字号
       ============================================================ -->
  <x:Double x:Key="FontSizeXSmall">10</x:Double>
  <x:Double x:Key="FontSizeSmall">11</x:Double>
  <x:Double x:Key="FontSizeBase">12</x:Double>
  <x:Double x:Key="FontSizeMedium">13</x:Double>
  <x:Double x:Key="FontSizeLarge">14</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeCardPort">17</x:Double>

</ResourceDictionary>
