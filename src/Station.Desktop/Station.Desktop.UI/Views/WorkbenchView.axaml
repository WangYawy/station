<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.UI.ViewModels"
             x:Class="Station.Desktop.UI.Views.WorkbenchView"
             x:DataType="vm:WorkbenchViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="14">
    <!-- 统计卡片 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
      <Border Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <StackPanel Spacing="4">
          <TextBlock Text="在线设备" Foreground="#64748b" FontSize="13" />
          <TextBlock Text="{Binding OnlineText}" FontSize="24" FontWeight="Bold" Foreground="#0a2f6c" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <StackPanel Spacing="4">
          <TextBlock Text="今日采集" Foreground="#64748b" FontSize="13" />
          <TextBlock Text="{Binding TodayText}" FontSize="24" FontWeight="Bold" Foreground="#2563eb" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <StackPanel Spacing="4">
          <TextBlock Text="待上传" Foreground="#64748b" FontSize="13" />
          <TextBlock Text="{Binding PendingUploadText}" FontSize="24" FontWeight="Bold" Foreground="#f59e0b" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <StackPanel Spacing="4">
          <TextBlock Text="本机状态" Foreground="#64748b" FontSize="13" />
          <TextBlock Text="{Binding SystemText}" FontSize="15" FontWeight="SemiBold" Foreground="#334155" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 设备连接池 + 采集队列 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
      <Border Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="📡 设备连接池" FontSize="16" FontWeight="Bold"
                     Foreground="#0a2f6c" Margin="0,0,0,10" />
          <ListBox ItemsSource="{Binding DevicePool}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceItem">
                <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                  <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1e293b" />
                  <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="13"
                             Foreground="{Binding StateColor}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"
              BoxShadow="0 2 8 0 #14000000">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="📋 采集队列（当前任务）" FontSize="16" FontWeight="Bold"
                     Foreground="#0a2f6c" Margin="0,0,0,10" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Border Background="#dbeafe" CornerRadius="9999" Padding="8,3">
              <TextBlock Text="全部状态" FontSize="12" Foreground="#1d4ed8" />
            </Border>
            <Border Background="#f1f5f9" CornerRadius="9999" Padding="8,3">
              <TextBlock Text="已同步" FontSize="12" Foreground="#64748b" />
            </Border>
            <Border Background="#f1f5f9" CornerRadius="9999" Padding="8,3">
              <TextBlock Text="同步中" FontSize="12" Foreground="#64748b" />
            </Border>
            <Border Background="#f1f5f9" CornerRadius="9999" Padding="8,3">
              <TextBlock Text="失败" FontSize="12" Foreground="#64748b" />
            </Border>
          </StackPanel>
          <ListBox ItemsSource="{Binding ActiveQueue}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:QueueItem">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Device}" FontSize="14" Foreground="#1e293b" />
                    <TextBlock Text="{Binding Task}" FontSize="12" Foreground="#64748b" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Progress}" FontSize="13" Foreground="#334155" Margin="0,0,12,0" />
                  <Border Grid.Column="2" Background="#f1f5f9" CornerRadius="9999" Padding="8,3">
                    <TextBlock Text="{Binding State}" FontSize="12" Foreground="{Binding StateColor}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- 状态监控 -->
    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16"
            BoxShadow="0 2 8 0 #14000000">
      <StackPanel Spacing="8">
        <TextBlock Text="状态监控" FontSize="16" FontWeight="Bold" Foreground="#0a2f6c" />
        <WrapPanel>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="CPU：" /><Run Text="{Binding MonitorLines[0].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="内存：" /><Run Text="{Binding MonitorLines[1].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="磁盘：" /><Run Text="{Binding MonitorLines[2].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="网络：" /><Run Text="{Binding MonitorLines[3].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="监听端口：" /><Run Text="{Binding MonitorLines[4].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
          <Border Background="#f1f5f9" CornerRadius="8" Padding="12,6" Margin="0,0,10,8">
            <TextBlock>
              <Run Text="设备：" /><Run Text="{Binding MonitorLines[5].Value}" Foreground="#0a2f6c" FontWeight="SemiBold" />
            </TextBlock>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
