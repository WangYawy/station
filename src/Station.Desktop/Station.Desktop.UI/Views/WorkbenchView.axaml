<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.ViewModels"
             xmlns:views="using:Station.Desktop.Views"
             x:Class="Station.Desktop.Views.WorkbenchView"
             x:DataType="vm:WorkbenchViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsScrollChainingEnabled="True">
    <ItemsControl ItemsSource="{Binding PortCards}" Height="{Binding GridHeight}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:UsbPortCardViewModel">
          <!-- Margin 8 = 卡片间距 16；必须与 WorkbenchView.axaml.cs 里的 GridSpacing / 2 保持一致 -->
          <views:UsbPortCardView Margin="8"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
