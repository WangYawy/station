<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Station.Desktop.Views.ShellWindow"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Title="视音频数据采集站 · 桌面端">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- =================== 顶部导航 =================== -->
    <Border Grid.Row="0"
            Height="{DynamicResource ShellTopNavHeight}"
            Background="{DynamicResource TopNavBackground}"
            BorderBrush="{DynamicResource TopNavBorder}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource PaddingTopNav}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- 品牌区 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconShield}"
                    Width="24" Height="24"
                    Foreground="{DynamicResource BrandAccent}"
                    VerticalAlignment="Center"/>
          <TextBlock Classes="brand-title" Text="视音频数据采集站"
                     FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <!-- 导航区 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="NavWorkbench" Tag="workbench" Classes="nav-pill nav-pill-selected" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconDashboard}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="采集监控" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavData" Tag="data" Classes="nav-pill" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconDatabase}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="数据管理" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavLogs" Tag="logs" Classes="nav-pill" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconLog}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="日志中心" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Tag="settings" Classes="nav-pill" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="设置" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- 右侧工具区 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="icon-btn" ToolTip.Tip="语言">
            <PathIcon Data="{StaticResource IconGlobe}" />
          </Button>
          <Button x:Name="ThemeToggleButton" Classes="icon-btn" ToolTip.Tip="切换主题"
                  Click="OnToggleThemeClick">
            <PathIcon x:Name="ThemeToggleIcon" Data="{StaticResource IconMoon}" Width="20" Height="20"/>
          </Button>
          <Button x:Name="NavAlerts" Classes="icon-btn" ToolTip.Tip="报警">
            <Grid>
              <PathIcon Data="{StaticResource IconBell}" />
              <Border Classes="alert-badge">
                <TextBlock Text="3"/>
              </Border>
            </Grid>
          </Button>
          <Border x:Name="LicenseBadge" Classes="license-badge" Margin="8,0,0,0">
            <TextBlock x:Name="LicenseBadgeText" Text="正式版 · 剩余365天"/>
          </Border>
          <Border Classes="session-badge" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="session-dot"/>
              <TextBlock x:Name="SessionStatusText" Text="未登录"/>
            </StackPanel>
          </Border>
          <Button x:Name="LogoutButton" Classes="logout-btn"
                  Content="退出登录" Click="OnLogoutClick" IsVisible="False"/>
          <Button x:Name="CloseAppButton" Classes="icon-btn exit-btn"
                  ToolTip.Tip="退出程序"
                  Click="OnCloseAppClick"
                  PointerPressed="OnCloseAppPointerPressed"
                  PointerReleased="OnCloseAppPointerReleased"
                  PointerCaptureLost="OnCloseAppPointerCaptureLost"
                  Margin="6,0,0,0">
            <PathIcon Data="{StaticResource IconClose}" Width="22" Height="22"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- =================== 公告栏 =================== -->
    <Border Grid.Row="1"
            x:Name="NoticeBar"
            Height="{DynamicResource ShellNoticeBarHeight}"
            Background="{DynamicResource NoticeBackground}"
            BorderBrush="{DynamicResource NoticeBorder}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource PaddingNoticeBar}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0" Data="{StaticResource IconMegaphone}"
                  Width="16" Height="16" Margin="0,0,14,0"
                  Foreground="{DynamicResource NoticeIcon}"
                  VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Classes="notice-text"
                   Text="系统升级通知：2026-07-10 02:00 维护，预计 2 小时。 | 新版本 v1.3 已发布，支持国密算法与存储熔断。"/>
        <Button Grid.Column="2" Classes="notice-close" Content="✕" Click="OnNoticeClose" />
      </Grid>
    </Border>
    <!-- =================== 空闲/报警横幅 =================== -->
    <StackPanel Grid.Row="2">
      <Border x:Name="IdleWarningBar" IsVisible="False"
              Background="{DynamicResource NoticeBackground}"
              BorderBrush="{DynamicResource NoticeBorder}"
              BorderThickness="0,0,0,1">
        <TextBlock x:Name="IdleWarningText"
                   Text="即将自动退出登录，请操作以保持会话"
                   Foreground="{DynamicResource NoticeText}"
                   FontSize="{DynamicResource FontSizeMedium}" Margin="16,4"
                   HorizontalAlignment="Center"/>
      </Border>
      <Border x:Name="AlertBanner" IsVisible="False"
              Background="{DynamicResource CardEmergencyBg}"
              BorderBrush="{DynamicResource CardEmergencyBorder}"
              BorderThickness="0,0,0,1"
              Tapped="OnAlertBannerTapped" Cursor="Hand">
        <TextBlock x:Name="AlertBannerText"
                   Foreground="{DynamicResource TextDanger}"
                   FontSize="{DynamicResource FontSizeMedium}"
                   Margin="16,4" HorizontalAlignment="Center"/>
      </Border>
    </StackPanel>
    <!-- =================== 主内容区 =================== -->
    <ContentControl Grid.Row="3" x:Name="ModuleContent" Margin="{DynamicResource PaddingContent}"/>
    <!-- =================== 底部状态栏 =================== -->
    <Border Grid.Row="4"
            Height="{DynamicResource ShellBottomBarHeight}"
            Background="{DynamicResource BottomBarBackground}"
            BorderBrush="{DynamicResource BottomBarBorder}"
            BorderThickness="0,1,0,0"
            Padding="{DynamicResource PaddingBottomBar}">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <!-- 本机 IP -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconServer}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BarIpText" Classes="bar-item" Text="本机IP: "/>
              <TextBlock Classes="bar-item" Text="192.168.1.10" />
            </StackPanel>
            <!-- 网络状态 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconWifi}" Width="14" Height="14"
                        Foreground="{DynamicResource TextSuccess}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BarNetState" Classes="bar-item success" Text="网络正常"/>
            </StackPanel>
            <!-- 心跳 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconHeart}" Width="14" Height="14"
                        Foreground="{DynamicResource TextDanger}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BarHeartbeat" Classes="bar-item danger" Text="心跳正常"/>
            </StackPanel>
            <Border Classes="bar-divider"/>
            <!-- CPU -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconCpu}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item" Text="CPU"/>
              <TextBlock x:Name="BarCpuText" Classes="bar-item" Text="—" />
            </StackPanel>
            <!-- 内存 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconMemory}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item" Text="内存"/>
              <TextBlock x:Name="BarMemText" Classes="bar-item" Text="—" />
            </StackPanel>
            <!-- 磁盘 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconDisk}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item" Text="磁盘"/>
              <TextBlock x:Name="BarDiskText" Classes="bar-item" Text="—" />
            </StackPanel>
            <Border Classes="bar-divider"/>
            <!-- 在线设备 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconUsb}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item" Text="在线"/>
              <TextBlock x:Name="BarOnlineText" Classes="bar-item" Text="—" />
            </StackPanel>
            <!-- 今日采集 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconMovie}" Width="14" Height="14"
                        Foreground="{DynamicResource BottomBarText}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item" Text="今日"/>
              <TextBlock x:Name="BarTodayText" Classes="bar-item" Text="—" />
            </StackPanel>
            <!-- 待上传 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconCloudUpload}" Width="14" Height="14"
                        Foreground="{DynamicResource TextWarning}" VerticalAlignment="Center"/>
              <TextBlock Classes="bar-item warning" Text="待上传"/>
              <TextBlock x:Name="BarPendingText" Classes="bar-item" Text="—" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- 右侧：时钟 -->
        <TextBlock Grid.Column="1" x:Name="ClockText"
                   FontSize="{DynamicResource FontSizeMedium}"
                   Foreground="{DynamicResource BottomBarClock}"
                   FontFamily="Consolas, Menlo, monospace"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
