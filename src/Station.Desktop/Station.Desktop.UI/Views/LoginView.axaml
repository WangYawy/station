<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.UI.ViewModels"
             x:Class="Station.Desktop.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid Background="#f1f5f9">
    <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="White" CornerRadius="12" Padding="36" BoxShadow="0 4 16 0 #20000000">
      <StackPanel Spacing="12">
        <TextBlock Text="视音频数据采集站" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="#0a2f6c" />
        <TextBlock Text="桌面端登录" FontSize="14" HorizontalAlignment="Center"
                   Foreground="#64748b" Margin="0,0,0,8" />

        <TextBlock Text="账号" Foreground="#334155" />
        <TextBox Text="{Binding UserName}" PlaceholderText="请输入账号" />

        <TextBlock Text="密码" Foreground="#334155" />
        <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="请输入密码" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#dc2626"
                   TextWrapping="Wrap" IsVisible="{Binding HasError}" />

        <Button Content="登 录" Command="{Binding LoginCommand}"
                IsDefault="True" IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch" Height="36"
                Background="#0a2f6c" Foreground="White" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
