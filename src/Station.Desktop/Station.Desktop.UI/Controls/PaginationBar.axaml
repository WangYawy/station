<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Station.Desktop.ViewModels"
             x:Class="Station.Desktop.Controls.PaginationBar"
             x:DataType="vm:PaginationViewModel">

  <UserControl.Styles>
    <Style Selector="Button.page">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#e2e8f0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="ComboBox.page">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

    <TextBlock Grid.Column="0" Text="{Binding SummaryText}" FontSize="12" Foreground="#64748b"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

      <ComboBox Classes="page" Width="88"
                ItemsSource="{Binding PageSizeOptions}"
                SelectedItem="{Binding PageSize}"
                IsVisible="{Binding ShowPageSizeSelector}" />

      <Button Classes="page" Content="首页" Command="{Binding FirstPageCommand}" />
      <Button Classes="page" Content="上一页" Command="{Binding PrevPageCommand}" />

      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowQuickJump}">
        <TextBlock Text="第" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" />
        <!-- NumericUpDown 清空输入会抛 Invalid cast from string to decimal?，
             TargetNullValue / FallbackValue 必须带 -->
        <NumericUpDown Value="{Binding PageInput, TargetNullValue=0, FallbackValue=0}"
                       Minimum="1" Maximum="{Binding MaxPage}"
                       Increment="1" FormatString="0" ShowButtonSpinner="False"
                       Width="56" MinHeight="32" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalPages, StringFormat='/ 共 {0} 页'}"
                   FontSize="12" Foreground="#64748b" VerticalAlignment="Center" />
        <Button Classes="page" Content="跳转" Command="{Binding GoToPageCommand}" />
      </StackPanel>

      <Button Classes="page" Content="下一页" Command="{Binding NextPageCommand}" />
      <Button Classes="page" Content="末页" Command="{Binding LastPageCommand}" />

      <Button Classes="page" Content="刷新" Command="{Binding RefreshCommand}"
              IsVisible="{Binding ShowRefresh}" />

    </StackPanel>

  </Grid>
</UserControl>
