{
  "Station": {
    "Db": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=station.db"
    },
    "Auth": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "AutoLogoutMinutes": 1
    },
    "OpAuth": {
      "RequiredModules": [ "workbench", "collect", "history", "logs", "settings" ]
    },
    "Collect": {
      "AutoCollectOnConnect": true,
      "SkipCollected": true,
      "EraseAfterComplete": false,
      "ChunkBytes": 1048576,
      "SimulatedFileCount": 5
    }
  }
}
