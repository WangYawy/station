# 平台 HTTP 端口（宿主机映射）
PLATFORM_HTTP_PORT=5100

# 默认管理员（首次启动播种）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# MySQL（docker-compose.yml）
MYSQL_ROOT_PASSWORD=Root@123
MYSQL_PASSWORD=Station@123

# PostgreSQL（docker-compose.pg.yml）
PG_PASSWORD=Station@123

# 金仓外部连接（docker-compose.kingbase.yml）
# KINGBASE_CONNECTION=Host=192.168.1.10;Port=54321;Database=station_platform;Username=system;Password=ChangeMe

# 安全密钥（生产必配）：
# 平台指令 SM2 私钥（下发给采集站指令签名，采集站内置对应公钥）
PLATFORM_COMMAND_PRIVATE_KEY=
# 采集站上报公钥（验签报警/授权状态上报）
PLATFORM_REPORTING_PUBLIC_KEY=
